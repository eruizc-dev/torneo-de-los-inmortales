{
  description = "A very basic flake";

  inputs = {
    nixpkgs.url = "https://channels.nixos.org/nixpkgs-unstable/nixexprs.tar.zst";
    flake-utils.url = "github:numtide/flake-utils";
    mvn2nix.url = "github:fzakaria/mvn2nix";
  };

  outputs = { self, nixpkgs, flake-utils, mvn2nix }: flake-utils.lib.eachDefaultSystem (system:
    let
      pkgs = import nixpkgs {
        inherit system;
        overlays = [ mvn2nix.overlay ];
      };

      # Hermetic Maven repository from the lock file generated by
      # `nix run .#mvn2nix > mvn2nix-lock.json`.
      mavenRepository = pkgs.buildMavenRepositoryFromLockFile {
        file = ./mvn2nix-lock.json;
      };
    in {
      packages.default = pkgs.stdenv.mkDerivation {
        pname = "paradigmas";
        version = "1.0-SNAPSHOT";
        src = ./.;

        nativeBuildInputs = [ pkgs.maven ];

        buildPhase = ''
          runHook preBuild
          # Copy the repo into a writable dir: store paths are read-only (Maven
          # wants to write .locks files) and Maven Resolver 2.x rejects symlinked
          # artifacts whose real path doesn't match the repo layout, so the
          # linkFarm symlinks must be dereferenced.
          cp -rL ${mavenRepository} $TMP/m2repo
          chmod -R u+w $TMP/m2repo
          mvn -B package --offline -Dmaven.repo.local=$TMP/m2repo
          runHook postBuild
        '';

        installPhase = ''
          runHook preInstall
          mkdir -p $out/bin $out/lib
          cp target/paradigmas-1.0-SNAPSHOT.jar $out/lib/paradigmas.jar
          makeWrapper ${pkgs.openjdk}/bin/java $out/bin/paradigmas \
            --add-args "-cp" "$out/lib/paradigmas.jar" "com.example.Main"
          runHook postInstall
        '';
      };

      apps.default = {
        type = "app";
        program = "${self.packages.${system}.default}/bin/paradigmas";
      };

      devShells.default = pkgs.mkShell {
        buildInputs = [
          pkgs.openjdk
          pkgs.maven
        ];
      };
    }
  );
}
